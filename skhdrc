# alt
alt - f : open -a finder
alt - s : open -a safari
alt - c : open -a calculator
alt - n : open -a notes
alt - 0 : open -a settings
alt - l : open -a /System/Applications/Launchpad.app
alt - i : open -a /System/Applications/iPhone\ Mirroring.app
alt - b : open -a /Applications/Brave\ Browser.app
alt - y : open -a safari https://translate.google.kz
alt - d : open -a /Applications/DaVinci\ Resolve.app
alt - o : open -a /Applications/OBS.app
alt - t : open -a /Applications/Telegram.app
alt - k : open -a /Applications/KeePassXC.app
alt - a: open -a /Applications/Ghostty.app
alt - z: open -a /Applications/FileZilla.app
alt - m: open -a /Applications/MacVim.app

# shift
alt + shift - t: open -a terminal
alt + shift - o : open -a /Applications/OrbStack.app
alt + shift - f : open -a /Applications/Figma.app
alt + shift - n: open -a /Applications/Numi.app
alt + shift - d: open -a /Applications/DBeaver.app
alt + shift - b: open -a /Applications/Borumi.app

# digits
alt - 0 : open -a settings
alt - 1: open -a /Applications/Visual\ Studio\ Code.app
alt - 2: open -a /Applications/Cursor.app
alt - 3: open -a /Applications/Codex.app

